# Optional API authentication tokens (comma-separated)
API_TOKENS=

# Server port (defaults to 3000)
PORT=3000

# Enable detailed chat/upload logs (true/false)
CHAT_DETAIL_LOG=false

# Express JSON request body limit
JSON_BODY_LIMIT=100mb

# Minimum video resolution for yt-dlp downloads (360, 480, 720)
MIN_VIDEO_RESOLUTION=480

# Optional path to Chrome/Chromium executable for real Baxia token generation
CHROME_PATH=

# Set to false to disable Chromium-based Baxia token generation
USE_CHROME_BAXIA=true

# Optional path to yt-dlp binary
YT_DLP_PATH=

# Auto-download yt-dlp binary if missing
YT_DLP_AUTO_DOWNLOAD=true

# Enable upstream web search by default (true/false)
ENABLE_SEARCH=false
